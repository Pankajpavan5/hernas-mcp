# All env vars are optional; this file documents the full surface.
# Copy to .env and load with your own mechanism (node does not read .env files natively).

HERNAS_PORT=7420
HERNAS_HOST=127.0.0.1        # loopback on purpose; off-loopback needs TLS in front
HERNAS_DATA=/data/data/com.termux/files/home/.hernas
HERNAS_RELAY_TOKEN=          # blank = generate + persist on first boot
HERNAS_MCP_PATH=/mcp

# agent bridge loop guards
HERNAS_MAX_HOPS=12
HERNAS_MAX_TURNS=4
HERNAS_COOLDOWN_MS=1500
HERNAS_THREAD_TOKENS=60000

# piggyback attachment
HERNAS_ATTACH_MAX=10
HERNAS_ATTACH_BYTES=8000

# device relay
HERNAS_POLL_SECONDS=25
HERNAS_CMD_TIMEOUT_MS=90000
HERNAS_MAX_OUTPUT=524288

HERNAS_SESSION_IDLE_MS=43200000
